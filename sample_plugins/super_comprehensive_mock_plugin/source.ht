/*
 * ============================================================================
 * PyroMagma 超级范本插件 (The Perfect Blueprint Plugin)
 * ============================================================================
 * 本文件是“大一统媒体架构”的终极参考实现。
 * 它演示了：API 模式、Scraper 模式、登录态维持、集合嵌套以及多模态字段填充。
 * 后续所有插件开发者应以此文件为基准进行“抄袭”式开发。
 */

import 'module:http' as http;
import 'module:host_webview' as webview;
import 'module:storage' as storage;
import 'module:html' as html;

var HttpClient = http.HttpClient;
var Webview = webview.Webview;
var Html = html.Html;

class Source {
  var id = 'org.pyromagma.blueprint.comprehensive';
  var name = 'Blueprint Comprehensive Source';
  var version = '2.0.0';

  var client;
  var isLogged = false;

  // 1. 能力清单：告诉宿主我能干什么，以及我是怎么干的
  fun manifest() {
    return {
      'id': id,
      'name': name,
      'contentType': 'universal', // 标志我可以返回任何媒体类型
      'capabilities': ['search', 'detail', 'scrape', 'login'], // 声明支持登录和抓取
      'methods': ['api', 'html'], // 混合获取模式
      'supportsScrobble': true,
      'scrobbleTargetTypes': ['music', 'video', 'novel']
    };
  }

  // 2. 初始化：配置全局 Header，包括从 WebView 交换来的 Cookie
  fun init(context) {
    var cookies = storage.get('auth_cookies'); // 从持久化存储读取登录态
    var options = http.HttpBaseOptions(
      headers: {
        'user-agent': Webview.getUserAgent(),
        'cookie': cookies != null ? cookies : '',
        'accept': 'application/json, text/html'
      }
    );
    client = HttpClient(options);
    if (cookies != null) isLogged = true;
  }

  // 3. 用户设置：提供登录开关和 API 密钥配置
  fun getConfigSchema() {
    return [
      {
        'key': 'api_key',
        'type': 'password',
        'label': 'API Key (Optional)',
        'hint': 'Enter API key if you have a developer account'
      },
      {
        'key': 'force_login',
        'type': 'boolean',
        'label': 'Require Login',
        'default': false
      }
    ];
  }

  // 4. 核心搜索：演示如何处理 API 返回和 HTML 抓取
  async fun search(query, page, {config}) {
    if (client == null) init(null);

    // 情况 A：如果有 API Key，走高速 API 模式
    if (config['api_key'] != null && config['api_key'] != '') {
       return await _searchByApi(query, page);
    }

    // 情况 B：没 API，走 HTML 模拟抓取模式
    return await _searchByScraping(query, page);
  }

  // 5. 详情抓取：演示“大一统”字段的极致填充
  async fun getDetail(id, {config}) {
    // 演示一个“全能条目”（有声小说示例）
    return {
      'id': id,
      'title': 'Blueprint Audio-Novel Example',
      'type': 'audio', // 建议渲染为音频

      // 创作者矩阵 (V2 规范)
      'creators': {
        'author': 'Original Writer',
        'singer': 'Voice Actor',
        'composer': 'Background Musician'
      },

      // 大一统字段池
      'mediaUrl': 'https://example.com/stream.mp3',
      'content': 'Chapter 1: The beginning of the blueprint...', // 同时提供正文
      'duration': 1800,
      'wordCount': 5600,
      'album': 'Blueprint Collection Vol.1',
      'trackNumber': 1,
      'lyrics': '[00:00.00] This is a blueprint lyric',

      // 集合特质
      'parentId': 'collection_v2_999',
      'index': 1.0,

      // 万能扩展
      'customMetadata': {
        'bitrate': '320kbps',
        'isrc': 'CN-A01-26-0001-0'
      }
    };
  }

  // --- 内部私有实现 (模拟逻辑) ---

  async fun _searchByApi(q, p) {
    // 调用 http.get 并解析 JSON
    // var resp = await client.get('https://api.site.com/search?q=' + q);
    // return resp.json['results'].map(...);
    return [{'id': 'api_1', 'title': q + ' (From API)'}];
  }

  async fun _searchByScraping(q, p) {
    // 调用 http.get 并使用 Html.parse
    // var resp = await client.get('https://site.com/search?q=' + q);
    // var doc = Html.parse(resp.body);
    // var items = doc.querySelectorAll('.item-row');
    return [{'id': 'html_1', 'title': q + ' (From Scraper)'}];
  }
}

export { Source }
