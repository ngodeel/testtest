class Source {
  var id = 'org.pyromagma.sync.bangumi';
  var name = 'Bangumi / AniList Manga Scrobbler';
  var version = '1.0.0';
  var author = 'PyroMagma Sync Team';
  var description = '动漫与漫画追漫章节打卡反推插件 (Bangumi/AniList Sync)';
  var icon = 'https://bgm.tv/img/favicon.ico';

  fun manifest() {
    return {
      'id': id,
      'name': name,
      'version': version,
      'description': description,
      'author': author,
      'icon': icon,
      'contentType': 'scrobbler',
      'supportsPush': true,
      'supportsScrobble': true,
      'scrobbleTargetTypes': ['comic', 'manga', 'anime']
    };
  }

  fun getConfigSchema() {
    return [
      {
        'key': 'access_token',
        'type': 'text',
        'label': 'Bangumi OAuth Access Token',
        'default': ''
      }
    ];
  }

  async fun scrobble(contentId, payload, {config}) {
    return await push(contentId, payload, config: config);
  }

  async fun push(contentId, payload, {config}) {
    var subjectTitle = payload['title'] != null ? payload['title'].toString() : contentId;
    var episode = payload['chapter'] != null ? payload['chapter'] : 1;

    return {
      'status': 'success',
      'service': 'Bangumi',
      'subject': subjectTitle,
      'chapterProgress': episode
    };
  }

  async fun pull(query, {config}) {
    return [];
  }
}

export { Source }
