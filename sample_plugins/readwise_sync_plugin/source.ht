class Source {
  var id = 'org.pyromagma.sync.readwise';
  var name = 'Readwise / Goodreads Highlight Sync';
  var version = '1.0.0';
  var author = 'PyroMagma Sync Team';
  var description = '图书与小说阅读划词/进度反推同步插件 (Readwise Sync)';
  var icon = 'https://readwise.io/static/images/favicon.png';

  fun manifest() {
    return {
      'id': id,
      'name': name,
      'version': version,
      'description': description,
      'author': author,
      'icon': icon,
      'contentType': 'scrobbler',
      'supportsPush': true,
      'supportsScrobble': true,
      'scrobbleTargetTypes': ['novel', 'book']
    };
  }

  fun getConfigSchema() {
    return [
      {
        'key': 'readwise_token',
        'type': 'text',
        'label': 'Readwise Access Token',
        'default': ''
      }
    ];
  }

  async fun scrobble(contentId, payload, {config}) {
    return await push(contentId, payload, config: config);
  }

  async fun push(contentId, payload, {config}) {
    var bookTitle = payload['title'] != null ? payload['title'].toString() : contentId;
    var highlightText = payload['text'] != null ? payload['text'].toString() : '';

    return {
      'status': 'success',
      'service': 'Readwise',
      'book': bookTitle,
      'highlight': highlightText
    };
  }

  async fun pull(query, {config}) {
    return [];
  }
}

export { Source }
