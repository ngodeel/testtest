import 'module:http' as http;
import 'module:host_webview' as webview;
import 'module:user' as user;
import 'module:storage' as storage;

var HttpClient = http.HttpClient;
var HttpBaseOptions = http.HttpBaseOptions;
var HttpResponse = http.HttpResponse;
var Webview = webview.Webview;

class Source {
  var id = 'org.pyromagma.wallpaper.unsplash';
  var name = 'Unsplash HD Source';
  var version = '1.0.0';
  var author = 'PyroMagma Team';
  var description = 'Unsplash 艺术与高画质摄影海报/壁纸插件';
  var icon = 'https://unsplash.com/favicon.ico';

  var client;

  fun manifest() {
    return {
      'id': id,
      'name': name,
      'version': version,
      'description': description,
      'author': author,
      'icon': icon,
      'languages': ['en'],
      'default_language': 'en'
    };
  }

  fun init(context) {
    var options = HttpBaseOptions(
      headers: {
        'user-agent': Webview.getUserAgent(),
      }
    );
    client = HttpClient(options);
  }

  fun getConfigSchema() {
    return [
      {
        "key": "api_key",
        "type": "text",
        "label": "Access Key (Client ID)",
        "default": "yTBcYNAtnRHbrYMn2p4DrBiqzOAfdH9nyexQQtJWO-E",
        "hint": "Unsplash Access Key"
      },
      {
        "key": "orientation",
        "type": "text",
        "label": "Orientation (portrait / landscape)",
        "default": "portrait",
        "hint": "landscape, portrait, squarish"
      }
    ];
  }

  fun getExploreConfig() {
    return [
      {'id': 'nature', 'title': 'Nature & Landscapes'},
      {'id': 'architecture', 'title': 'Architecture'},
      {'id': 'wallpapers', 'title': 'Wallpapers'},
      {'id': 'travel', 'title': 'Travel'}
    ];
  }

  async fun search(query, page, {config}) {
    if (client == null) init(null);

    var baseUrl = 'https://api.unsplash.com';
    var accessKey = 'yTBcYNAtnRHbrYMn2p4DrBiqzOAfdH9nyexQQtJWO-E';
    var orientation = 'portrait';

    if (config != null) {
       if (config['api_key'] != null && config['api_key'] != '') accessKey = config['api_key'];
       if (config['orientation'] != null && config['orientation'] != '') orientation = config['orientation'];
    }

    var isRandom = (query == null || query == '' || query == 'random');
    var url = isRandom ? baseUrl + '/photos/random' : baseUrl + '/search/photos';

    var params = {
       'client_id': accessKey,
       'page': page.toString(),
       'per_page': '30',
       'content_filter': 'low'
    };

    if (isRandom) {
       params['count'] = '30';
       params['orientation'] = orientation;
    } else {
       params['query'] = query.toString();
       params['orientation'] = orientation;
    }

    var res = await client.get_req(url, queryParameters: params);
    if (res == null || res.statusCode != 200 || res.data == null) {
        return [];
    }

    var list = [];
    if (res.data is List) {
        list = res.data;
    } else if (res.data is Map && res.data['results'] != null) {
        list = res.data['results'];
    }

    var results = [];
    for (var i = 0; i < list.length; i++) {
        var item = list[i];
        var urls = item['urls'];
        if (urls == null) continue;

        var userName = 'Unsplash Creator';
        var userAvatar = '';
        var userUrl = 'https://unsplash.com';
        if (item['user'] != null) {
          if (item['user']['name'] != null) userName = item['user']['name'];
          if (item['user']['profile_image'] != null && item['user']['profile_image']['medium'] != null) {
            userAvatar = item['user']['profile_image']['medium'];
          }
          if (item['user']['links'] != null && item['user']['links']['html'] != null) {
            userUrl = item['user']['links']['html'];
          }
        }

        var titleStr = 'Unsplash Image';
        if (item['description'] != null && item['description'] != '') titleStr = item['description'];
        else if (item['alt_description'] != null && item['alt_description'] != '') titleStr = item['alt_description'];

        results.add({
            'id': item['id'].toString(),
            'url': urls['raw'] != null ? urls['raw'] + '&w=2160&fmt=webp' : (urls['full'] ?? urls['small']),
            'thumbnail': urls['small'] ?? urls['thumb'],
            'title': titleStr,
            'author': {
              'id': userName,
              'name': userName,
              'avatar': userAvatar,
              'homeUrl': userUrl
            },
            'likes_count': item['likes'],
            'published_at': item['created_at'],
            'contentType': 'wallpaper',
            'originUrl': item['links'] != null ? item['links']['html'] : ''
        });
    }
    return results;
  }

  async fun explore(category, page, {config}) {
    return await search(category, page, config: config);
  }

  async fun getDetail(id, {config}) {
    if (client == null) init(null);
    var accessKey = 'yTBcYNAtnRHbrYMn2p4DrBiqzOAfdH9nyexQQtJWO-E';
    var url = 'https://api.unsplash.com/photos/' + id.toString() + '?client_id=' + accessKey;

    var res = await client.get_req(url);
    if (res == null || res.statusCode != 200 || res.data == null) return null;
    var item = res.data;
    var urls = item['urls'];
    if (urls == null) return null;

    var userName = 'Unsplash Creator';
    var userAvatar = '';
    if (item['user'] != null) {
      if (item['user']['name'] != null) userName = item['user']['name'];
      if (item['user']['profile_image'] != null && item['user']['profile_image']['medium'] != null) {
        userAvatar = item['user']['profile_image']['medium'];
      }
    }

    return {
        'id': item['id'].toString(),
        'title': item['description'] ?? item['alt_description'] ?? 'Unsplash Image',
        'images': [urls['raw'] != null ? urls['raw'] + '&w=2160&fmt=webp' : urls['full']],
        'url': urls['raw'] != null ? urls['raw'] + '&w=2160&fmt=webp' : urls['full'],
        'author': {
          'name': userName,
          'avatar': userAvatar
        },
        'likes_count': item['likes'],
        'downloads_count': item['downloads'],
        'views_count': item['views'],
        'contentType': 'wallpaper',
        'published_at': item['created_at']
    };
  }
}

export { Source }
