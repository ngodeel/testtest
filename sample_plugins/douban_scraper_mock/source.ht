import 'module:http' as http;
import 'module:host_webview' as webview;

class Source {
  var id = 'org.pyromagma.scraper.douban.mock';
  var name = 'Douban Scraper Mock';
  var version = '1.0.0';

  fun manifest() {
    return {
      'id': id,
      'name': name,
      'version': version,
      'contentType': 'universal',
      'supportsSearch': true,
      'supportsDetail': true,
      'capabilities': ['scraper']
    };
  }

  fun init(context) {}

  async fun search(query, page, {config}) {
    // 模拟匹配逻辑
    if (query.contains('三体')) {
      return [{
        'id': 'douban_123456',
        'title': '三体 (豆瓣模拟结果)',
        'cover': 'https://picsum.photos/id/10/600/900',
        'author': {'name': '刘慈欣'}
      }];
    }
    return [];
  }

  async fun getDetail(id, {config}) {
    if (id == 'douban_123456') {
      return {
        'id': 'douban_123456',
        'cover': 'https://picsum.photos/id/10/600/900',
        'description': '文化大革命如火如荼进行之际。军方探寻外星文明的绝秘计划“红岸工程”取得了突破性进展...',
        'rating': 9.2,
        'tags': ['科幻', '硬科幻', '中国文学']
      };
    }
    return {};
  }
}

export { Source }
